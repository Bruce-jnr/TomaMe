# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://postgres:password@localhost:5432/toabapa?schema=public"

NODE_ENV=development
API_PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
SESSION_SECRET=replace-with-at-least-32-random-characters
SEED_ADMIN_EMAIL=organizer@toabapa.test
SEED_ADMIN_PASSWORD=replace-with-a-development-only-password
LOG_LEVEL=info

# In production, prefer *_FILE variants for mounted secrets.

PAYSTACK_PUBLIC_KEY=pk_test_replace_me
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_WEBHOOK_SECRET=replace_me

ARKESEL_API_KEY=replace_me
ARKESEL_SENDER_ID=Toabapa
# Use a random value of at least 24 characters. Configure Arkesel callback as
# https://api.example.com/api/v1/ussd/arkesel?token=<same-value>
ARKESEL_USSD_SECRET=replace-with-a-random-callback-secret

WEBHOOK_RETRY_INTERVAL_MS=30000

STORAGE_ACCESS_KEY=replace_me
STORAGE_SECRET_KEY=replace_me
STORAGE_BUCKET=toabapa
STORAGE_ENDPOINT=replace_me
